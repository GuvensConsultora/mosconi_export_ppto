
<odoo>
    <!-- Por qué: Agregar chatter a la vista de payment.transaction -->
    <!-- Patrón: Herencia de vistas en Odoo -->
    <record id="view_payment_transaction_form_inherit" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.view_payment_transaction_form"/>
        <field name="arch" type="xml">
            <!-- Por qué: Agregar chatter al final del formulario -->
            <xpath expr="//form" position="inside">
                <chatter/>
            </xpath>
        </field>
    </record>
</odoo>
